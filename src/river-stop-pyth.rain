version: 6

orders:
  base:
    raindex: base
    inputs:
      - token: input
    outputs:
      - token: output

scenarios:
  river-stop-pyth-base:
    raindex: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      pyth-subparser: 0x21026b98bA3909E34e9a42295A812614bb0C7F21
      erc4626-subparser: 0xd69dC3d58a7C875117f9c7cecF4F1A7f3CA47254
      shares-per-token-fn: '''one-share'
      wt-vault: ${order.outputs.0.token.address}
  river-stop-pyth-base-wt:
    raindex: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      pyth-subparser: 0x21026b98bA3909E34e9a42295A812614bb0C7F21
      erc4626-subparser: 0xd69dC3d58a7C875117f9c7cecF4F1A7f3CA47254
      shares-per-token-fn: '''wt-vault-assets'
      wt-vault: ${order.outputs.0.token.address}

deployments:
  base:
    order: base
    scenario: river-stop-pyth-base
  base-wt:
    order: base
    scenario: river-stop-pyth-base-wt

builder:
  name: Stop-loss (Pyth)
  description: Sells a stock token for USDC once the Pyth US price is at or below your trigger, never below oracle price x your floor.
  short-description: Sell when the oracle price falls to your trigger.
  deployments:
    base:
      name: Base stop-loss
      description: >
        Sells the deposited stock token for USDC once the onchain Pyth price for
        the stock is at or below the trigger. Each fill pays at least
        Pyth price x floor per token. Inactive while the onchain Pyth price is older than the timeout: a keeper posts a fresh Pyth update when it takes the order.
      deposits:
        - token: output
      fields:
        - binding: pyth-pair
          name: Pyth price feed pair
          description: The Pyth pair for the stock being sold, e.g. "Equity.US.AAPL/USD" (the sub-parser's bytes32 symbol).
          show-custom-field: true
        - binding: trigger-price
          name: Trigger price (USD per share)
          description: The order can only fill when the Pyth price is at or below this.
          show-custom-field: true
        - binding: floor-multiplier
          name: Floor (fraction of oracle price)
          description: Minimum accepted USDC per token as a fraction of the Pyth price, e.g. 0.98.
          show-custom-field: true
          default: 0.98
        - binding: oracle-price-timeout
          name: Oracle price max age (seconds)
          description: The order is inactive while the oracle price is older than this.
          show-custom-field: true
          default: 300
      select-tokens:
        - key: output
          name: Stock token to sell
          description: The token sold when the stop triggers.
        - key: input
          name: Receive
          description: The stablecoin you receive (USDC).
    base-wt:
      name: Base stop-loss (ST0x wt tokens)
      description: >
        Sells the deposited stock token for USDC once the onchain Pyth price for
        the stock is at or below the trigger. Each fill pays at least
        Pyth price x the vault's live shares-per-token x floor per token. Inactive while the onchain Pyth price is older than the timeout: a keeper posts a fresh Pyth update when it takes the order.
      deposits:
        - token: output
      fields:
        - binding: pyth-pair
          name: Pyth price feed pair
          description: The Pyth pair for the stock being sold, e.g. "Equity.US.AAPL/USD" (the sub-parser's bytes32 symbol).
          show-custom-field: true
        - binding: trigger-price
          name: Trigger price (USD per share)
          description: The order can only fill when the Pyth price is at or below this.
          show-custom-field: true
        - binding: floor-multiplier
          name: Floor (fraction of oracle price)
          description: Minimum accepted USDC per token as a fraction of the Pyth price, e.g. 0.98.
          show-custom-field: true
          default: 0.98
        - binding: oracle-price-timeout
          name: Oracle price max age (seconds)
          description: The order is inactive while the oracle price is older than this.
          show-custom-field: true
          default: 300
      select-tokens:
        - key: output
          name: Stock token to sell
          description: The token sold when the stop triggers.
        - key: input
          name: Receive
          description: The stablecoin you receive (USDC).
---
#raindex-subparser !Raindex subparser.
#pyth-subparser !Pyth words subparser (pyth-price).
#pyth-pair !The Pyth pair of the stock sold.
#trigger-price !Fill only when the Pyth price is at or below this (USD per share).
#floor-multiplier !Minimum USDC per token as a fraction of the Pyth price.
#oracle-price-timeout !Max oracle price age in seconds.
#erc4626-subparser !ERC4626 words (erc4626-convert-to-assets).
#shares-per-token-fn !Underlying shares per token sold: 1, or the wt vault's live ratio.
#wt-vault !The wt vault token sold (wt deployment only).

#one-share
_: 1;

#wt-vault-assets
_: erc4626-convert-to-assets(wt-vault 1);

#calculate-io
using-words-from raindex-subparser pyth-subparser erc4626-subparser
price _: pyth-price(pyth-pair oracle-price-timeout),
shares-per-token: call<'shares-per-token-fn>(),
:ensure(less-than-or-equal-to(price trigger-price) "Stop not triggered"),
max-output: max-positive-value(),
io: mul(price shares-per-token floor-multiplier);

#handle-io
:;

#handle-add-order
:;
